---
import '../styles/global.css';
import { Mascot } from '../components/Mascot';

interface Props {
  title: string;
  description: string;
  page?: string;
}
const { title, description, page } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <header class="nav">
      <a class="brand" href="/">
        <span class="brand-mark"><Mascot client:load mood="idle" size={30} /></span>
        <span>Swaprika</span>
      </a>
      <nav>
        <a href="/" aria-current={page === 'home' ? 'page' : undefined}>Overview</a>
        <a href="/docs" aria-current={page === 'docs' ? 'page' : undefined}>Docs</a>
        <a href="/graphql">Playground</a>
        <a href="https://nagysolution.com">Nagy Solution</a>
      </nav>
    </header>

    <slot />

    <footer>
      <p>
        Code MIT, on <a href="https://github.com/n3ndor/swaprika">GitHub</a>.
        Substitution data CC BY-NC-SA 4.0, commercial licence available.
        A <a href="https://nagysolution.com">Nagy Solution</a> project.
      </p>
    </footer>
  </body>
</html>
