---
import '../styles/organic.css';
import '../styles/app.css';
import App from '../components/App';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Swaprika, what to use instead and where it works</title>
    <meta
      name="description"
      content="A swap is only true somewhere. Butter becomes oil in a cake and ruins a croissant. Pick where you are cooking and what ran out, and Swaprika shows what to use instead, what it changes, and where it fails."
    />
    <meta name="theme-color" content="#f5ead8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    <!-- Server rendered and fully static: the data is in the bundle and there is
         no backend. The curtain is an overlay, not a gate on the page beneath. -->
    <App client:load />

    <noscript>
      <style>.curtain { display: none !important; } .is-hidden { display: block !important; }</style>
    </noscript>
  </body>
</html>
