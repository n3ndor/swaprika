{
  "name": "swaprika",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swaprika",
      // Placeholder until `wrangler d1 create swaprika` is run against a real account.
      // Local development with `wrangler dev` does not need a real id.
      "database_id": "local-placeholder"
    }
  ]
}
