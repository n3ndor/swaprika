{
  "name": "swaprika",
  "compatibility_date": "2026-09-01",
  // Static assets only, no Worker script. Cloudflare serves asset requests
  // free and unmetered, so the site never touches the Workers request limits.
  "assets": {
    "directory": "./web/dist"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "swaprika.nagysolution.com", "custom_domain": true }
  ]
}
